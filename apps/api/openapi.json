  "components": {
    "schemas": {
      "CreateTest": {
        "properties": {
          "sentence": {
            "type": "string",
            "maxLength": 180,
            "minLength": 1,
            "title": "Sentence"
          },
          "intended_label": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Intended Label"
          },
          "distractors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Distractors"
          },
          "direction": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Direction"
          },
          "audio_id": {
            "type": "string",
            "minLength": 1,
            "title": "Audio Id"
          },
          "option_descriptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 4,
            "title": "Option Descriptions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sentence",
          "intended_label",
          "distractors",
          "direction",
          "audio_id"
        ],
        "title": "CreateTest"
      },
      "GenerateRequest": {
        "properties": {
          "sentence": {
            "type": "string",
            "maxLength": 180,
            "minLength": 1,
            "title": "Sentence"
          },
          "direction": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Direction"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sentence",
          "direction"
        ],
        "title": "GenerateRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SuggestRequest": {
        "properties": {
          "sentence": {
            "type": "string",
            "maxLength": 180,
            "minLength": 1,
            "title": "Sentence"
          },
          "intended_label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "null"
              }
            ],
            "title": "Intended Label"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sentence"
        ],
        "title": "SuggestRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VoteRequest": {
        "properties": {
          "participant_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 24,
            "title": "Participant Id"
          },
          "selected_option_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Option Id"
          },
          "selected_label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Label"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "participant_id"
        ],
        "title": "VoteRequest"
      }
    }
  }
