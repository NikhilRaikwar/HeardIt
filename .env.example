# FastAPI server values, except where noted. Keep provider keys out of NEXT_PUBLIC_* variables.
HEARDIT_ENV=development
# Required in production: generate a private random value of at least 32 characters.
HEARDIT_SIGNING_SECRET=
HEARDIT_TRUST_PROXY=false
HEARDIT_ASSIGNMENT_TOKEN_MAX_AGE_SECONDS=604800
HEARDIT_PUBLISH_IP_HOURLY=20
HEARDIT_PUBLISH_AUDIO_HOURLY=20
HEARDIT_ASSIGNMENT_IP_MINUTE=60
HEARDIT_ASSIGNMENT_TEST_MINUTE=300
HEARDIT_VOTE_IP_MINUTE=30
HEARDIT_VOTE_TEST_MINUTE=120
HEARDIT_TESTS_DAILY_CAP=500
HEARDIT_VOTES_PER_TEST_DAILY_CAP=10000
HEARDIT_CAPTCHA_ENABLED=false
HEARDIT_TURNSTILE_SECRET=
HEARDIT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=heardit

# Set the same 32+ character random value in Next.js and FastAPI deployments.
# It unlocks the private /admin metrics page and its API route.
ADMIN_KEY=

FISH_API_KEY=
FISH_TTS_MODEL=s2.1-pro-free

AIML_API_KEY=
AIML_MODEL=gpt-4o-mini

# Server-side Next.js rewrite target for FastAPI. On Vercel set this to the
# HTTPS URL of the separately deployed FastAPI project.
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional API target override for the guarded live smoke script.
HEARDIT_API_URL=http://127.0.0.1:8000
# Optional, browser-side product analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
