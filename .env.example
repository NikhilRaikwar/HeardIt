# FastAPI only. Keep provider keys out of NEXT_PUBLIC_* variables.
HEARDIT_ENV=development
HEARDIT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=heardit

FISH_API_KEY=
FISH_TTS_MODEL=s2.1-pro-free

AIML_API_KEY=
AIML_MODEL=gpt-4o-mini

# Server-side Next.js rewrite target for FastAPI. On Vercel set this to the
# HTTPS URL of the separately deployed FastAPI project.
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional public API origin that stores the four curated sample clips.
NEXT_PUBLIC_HEARDIT_SAMPLE_AUDIO_ORIGIN=

# Optional, browser-side product analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
